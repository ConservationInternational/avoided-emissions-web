manifest {
    name = 'avoided-emissions'
    version = '1.0.0'
    nextflowVersion = '=26.10.6'
}

plugins {
    id 'nf-amazon@3.12.1'
}

params {
    analysis_file = null
    state_uri = null
    execution_id = 'local'
    image = null
    worker = '/app/nextflow_worker.py'
    spot_queue = 'ae-spot-gp3'
    ondemand_queue = 'ae-ondemand-gp3'
    allow_ondemand = false
    job_role = null
    max_forks = 20
    match_memory_mib = 30720
    max_memory_mib = 122880
}

process {
    executor = 'awsbatch'
    container = params.image
    queue = {
        params.allow_ondemand && task.attempt > 1 ? params.ondemand_queue : params.spot_queue
    }
    cpus = 2
    memory = {
        def reason = [
            task.previousException?.message,
            task.previousException?.cause?.message
        ].join(' ')
        def factor = reason.contains('OutOfMemoryError') ? (1L << (task.attempt - 1)) : 1L
        reason.contains('OutOfMemoryError') ?
            Math.min(params.max_memory_mib as long, (params.match_memory_mib as long) * factor) + ' MB' :
            (task.previousTrace?.memory ?: "${params.match_memory_mib} MB")
    }
    time = { Math.min(16, 4 * (1 << (task.attempt - 1))) + 'h' }
    maxRetries = 2
    maxErrors = -1
    errorStrategy = {
        def reason = [
            task.previousException?.message,
            task.previousException?.cause?.message,
            task.previousException?.cause?.cause?.message
        ].join(' ')
        def retryable = task.exitStatus == 75 ||
            reason.contains('Host EC2') ||
            reason.contains('OutOfMemoryError') ||
            reason.contains('exceeded timeout') ||
            reason.contains('exceeded the time limit')
        retryable ? 'retry' : 'finish'
    }
    resourceLabels = [execution_id: params.execution_id, project: 'avoided-emissions']
    withName: EXTRACT {
        cpus = 4
        memory = {
            def reason = [task.previousException?.message, task.previousException?.cause?.message].join(' ')
            reason.contains('OutOfMemoryError') ?
                (128 * (1 << (task.attempt - 1))) + ' GB' :
                (task.previousTrace?.memory ?: '128 GB')
        }
    }
    withName: PREPARE_MATCH_BATCHES {
        memory = {
            def reason = [task.previousException?.message, task.previousException?.cause?.message].join(' ')
            reason.contains('OutOfMemoryError') ?
                (32 * (1 << (task.attempt - 1))) + ' GB' :
                (task.previousTrace?.memory ?: '32 GB')
        }
    }
    withName: 'PREPARE_RECOVERY|PREPARE_LONG|RECONCILE' {
        memory = '4 GB'
        cpus = 1
    }
    withName: SUMMARIZE {
        memory = {
            def reason = [task.previousException?.message, task.previousException?.cause?.message].join(' ')
            reason.contains('OutOfMemoryError') ?
                (32 * (1 << (task.attempt - 1))) + ' GB' :
                (task.previousTrace?.memory ?: '32 GB')
        }
        time = { Math.min(24, 6 * (1 << (task.attempt - 1))) + 'h' }
    }
    withName: 'MATCH_BATCH|MATCH_RECOVERY|MATCH_LONG' {
        maxForks = params.max_forks
    }
    withName: MATCH_LONG {
        time = { Math.min(16, 8 * (1 << (task.attempt - 1))) + 'h' }
        queue = { params.allow_ondemand ? params.ondemand_queue : params.spot_queue }
    }
}

executor {
    queueSize = params.max_forks
    submitRateLimit = '10/1sec'
}

aws {
    region = env('AWS_REGION') ?: 'us-east-1'
    batch {
        // One native attempt; bounded Nextflow retries own recovery.
        maxSpotAttempts = 1
        jobRole = params.job_role
        maxParallelTransfers = 4
        terminateUnschedulableJobs = true
    }
}

trace {
    enabled = true
    file = 'trace.tsv'
    overwrite = true
    fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,realtime,peak_rss'
}

profiles {
    local {
        process.executor = 'local'
        process.container = null
        process.resourceLabels = [:]
        process.memory = null
        process.cpus = 1
        process.time = '1h'
        process {
            withName: EXTRACT {
                memory = null
                cpus = 1
            }
            withName: PREPARE_MATCH_BATCHES { memory = null }
            withName: SUMMARIZE { memory = null }
            withName: 'PREPARE_RECOVERY|PREPARE_LONG|RECONCILE' { memory = null }
        }
    }
}
