# Environment variables for the avoided emissions web application.
# Copy this to .env and fill in actual values.
#
# In CI/CD, this file is generated automatically by the GitHub Actions
# workflow from repository secrets and variables — see deploy/README.md.

# -- Container images --------------------------------------------------------
# Set by GitHub Actions; override locally for development.
ECR_REGISTRY=
WEBAPP_IMAGE=avoided-emissions-webapp:latest
RANALYSIS_IMAGE=
R_ANALYSIS_IMAGE_TAG=latest

# -- Environment -------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
# Auto-adopt untracked API executions into the local database.
# Enabled by default only when ENVIRONMENT=development.
# Set to true/false to override.
# ENABLE_TASK_ADOPTION=true

# -- App ---------------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-string
# Public URL of the web app.  The OIDC redirect URI is APP_URL/auth/callback
# and the post-logout redirect URI is APP_URL/ — both must be registered on
# the Trends.Earth OIDC client.
APP_URL=http://localhost:8050

# -- Sign-in (Trends.Earth OIDC) ---------------------------------------------
# Users sign in with their Trends.Earth account.  Access to this app is
# granted per user in Trends.Earth (app key OIDC_APP_KEY).  Local development
# and staging use the staging client/app; production uses the defaults.
OIDC_ISSUER=https://api.trends.earth
OIDC_CLIENT_ID=avoided-emissions-web-staging
OIDC_CLIENT_SECRET=
OIDC_ACCESS_AUDIENCE=avoided-emissions-staging
OIDC_APP_KEY=avoided_emissions_staging
# Server-side sessions are stored in Redis (defaults to CELERY_BROKER_URL).
# SESSION_REDIS_URL=redis://redis:6379/0

# -- Database ----------------------------------------------------------------
POSTGRES_USER=ae_user
POSTGRES_PASSWORD=ae_password
POSTGRES_DB=avoided_emissions
# DATABASE_URL is auto-constructed from the POSTGRES_* vars above.
# Set it explicitly only if you need a non-standard connection string.
# DATABASE_URL=postgresql://ae_user:ae_password@postgres:5432/avoided_emissions

# -- AWS ---------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
# AWS credentials for local development.  On EC2/ECS these are provided by
# the instance role — leave blank in staging/production.
#
# REQUIRED for multi-container dev (docker-compose.develop.yml): the webapp
# and Celery worker containers have separate filesystems, so staged site
# uploads are stored in S3 rather than local /tmp.  Without valid credentials
# and a reachable S3_BUCKET, site file uploads will fail in the worker.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=avoided-emissions-data
# S3 prefix used to build COG paths and site-upload staging:
#   COG layers : <S3_PREFIX>/cog_1km/<name>.tif
#   Upload stage: <S3_PREFIX>/site-upload-stage/<token>.{bin,json}
S3_PREFIX=avoided-emissions

# -- trends.earth API --------------------------------------------------------
# URL for the trends.earth API (v1 endpoint).
TRENDSEARTH_API_URL=https://api.trends.earth/api/v1
# OAuth2 service credentials used ONLY for background polling of execution
# status and task adoption.  Analyses are submitted with each signed-in
# user's own Trends.Earth access token.
TRENDSEARTH_CLIENT_ID=
TRENDSEARTH_CLIENT_SECRET=
# Script ID for the avoided-emissions R analysis script on the API.
TRENDSEARTH_SCRIPT_ID=
# Optional: AWS Batch job queue and job definition overrides.
# Sent in params["batch"] when creating an execution on the API.
# Leave blank to use the defaults configured on the Script / API side.
BATCH_JOB_QUEUE=
BATCH_JOB_DEFINITION=

# -- Google Cloud / GEE ------------------------------------------------------
GCS_BUCKET=
GCS_PREFIX=avoided-emissions/covariates_1km
# Google Cloud project registered for Earth Engine access.
# Required for ee.Initialize() in newer versions of the EE Python API.
GOOGLE_PROJECT_ID=
# Optional: Earth Engine API endpoint (e.g. high-volume endpoint).
# Leave blank to use the default endpoint.
GEE_ENDPOINT=
# Service account JSON (base64 or inline) for Earth Engine access.
# Used by the webapp to trigger GEE covariate exports.  The R analysis
# container does NOT need this — it reads COGs from the public GCS bucket
# via GDAL /vsicurl/.
# In CI this is set from the EE_SERVICE_ACCOUNT_JSON secret.
EE_SERVICE_ACCOUNT_JSON=

# -- Celery (Redis) ----------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -- Rollbar error tracking --------------------------------------------------
ROLLBAR_ACCESS_TOKEN=
ROLLBAR_ENVIRONMENT=development

# -- Deployment info (set automatically by CI) --------------------------------
GIT_REVISION=
